#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fixture=$(mktemp -d)
trap 'rm -rf -- "$fixture"' EXIT
mkdir -p "$fixture/bin" "$fixture/script" "$fixture/registry" "$fixture/extensions"
cp "$repo_root/script/publish" "$fixture/script/publish"
printf '%s\n' '{"extensions": []}' > "$fixture/registry/index.json"
for id in html emmet git-firefly; do
    mkdir -p "$fixture/extensions/$id"
    cp "$repo_root/extensions/$id/extension.toml" "$fixture/extensions/$id/extension.toml"
done

cat > "$fixture/bin/gh" <<'STUB'
#!/usr/bin/env bash
if [[ "$1 $2" == 'release view' ]]; then
    [[ "${RELEASE_EXISTS:-0}" == 1 ]]
    exit
fi
if [[ "$1 $2" == 'release create' ]]; then
    printf 'release create %s\n' "$*" >> "$CALLS"
    exit 0
fi
printf 'unexpected gh call: %s\n' "$*" >&2
exit 99
STUB
cat > "$fixture/bin/git" <<'STUB'
#!/usr/bin/env bash
if [[ "$*" == *' status --porcelain'* ]]; then
    [[ "${DIRTY:-0}" == 1 ]] && printf ' M extensions/html/extension.toml\n'
    exit 0
fi
if [[ "$*" == *' rev-list --count '* ]]; then
    printf '%s\n' "${UNPUSHED:-0}"
    exit 0
fi
if [[ "$*" == *' rev-parse HEAD'* ]]; then
    printf 'test-head-sha\n'
    exit 0
fi
case " $* " in
    *' add registry/index.json '*|*' commit '*) exit 0 ;;
    *' push '*)
        printf 'push\n' >> "$CALLS"
        [[ "${PUSH_FAIL:-0}" == 0 ]]
        exit ;;
esac
printf 'unexpected git call: %s\n' "$*" >&2
exit 99
STUB
cat > "$fixture/bin/symbiont-extension" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
while (($#)); do
    case "$1" in
        --output-dir) output_dir=$2; shift 2 ;;
        --source-dir) source_dir=$2; shift 2 ;;
        --scratch-dir) shift 2 ;;
        *) exit 99 ;;
    esac
done
mkdir -p "$output_dir"
printf 'test archive' > "$output_dir/archive.tar.gz"
python3 - "$source_dir/extension.toml" "$output_dir/manifest.json" <<'PY'
import json
import sys
import tomllib
with open(sys.argv[1], 'rb') as file:
    manifest = tomllib.load(file)
metadata = {key: manifest[key] for key in ('name', 'version', 'description', 'authors', 'repository', 'schema_version')}
metadata['wasm_api_version'] = None if manifest['id'] == 'git-firefly' else '0.1.0'
metadata['provides'] = {
    'html': ['languages', 'grammars', 'language-servers'],
    'emmet': ['language-servers'],
    'git-firefly': ['languages', 'grammars'],
}[manifest['id']]
with open(sys.argv[2], 'w') as file:
    json.dump(metadata, file)
PY
STUB
chmod +x "$fixture/bin/gh" "$fixture/bin/git" "$fixture/bin/symbiont-extension"

before=$(sha256sum "$fixture/registry/index.json")
export CALLS="$fixture/calls"
: > "$CALLS"
if (cd "$fixture" && PATH="$fixture/bin:$PATH" DIRTY=1 script/publish html > "$fixture/dirty.out" 2>&1); then
    printf 'FAIL: dirty tree was accepted\n' >&2
    exit 1
fi
grep -q 'dirty' "$fixture/dirty.out" || { cat "$fixture/dirty.out" >&2; exit 1; }
[[ "$(sha256sum "$fixture/registry/index.json")" == "$before" ]] || { printf 'FAIL: index changed on dirty tree\n' >&2; exit 1; }
[[ ! -s "$CALLS" ]] || { printf 'FAIL: dirty tree reached push or release\n' >&2; exit 1; }

if (cd "$fixture" && PATH="$fixture/bin:$PATH" UNPUSHED=1 script/publish html > "$fixture/unpushed.out" 2>&1); then
    printf 'FAIL: unpushed tree was accepted\n' >&2
    exit 1
fi
grep -q 'unpushed' "$fixture/unpushed.out" || { cat "$fixture/unpushed.out" >&2; exit 1; }
[[ ! -s "$CALLS" ]] || { printf 'FAIL: unpushed tree reached push or release\n' >&2; exit 1; }

if (cd "$fixture" && PATH="$fixture/bin:$PATH" RELEASE_EXISTS=1 script/publish html > "$fixture/existing.out" 2>&1); then
    printf 'FAIL: existing release was accepted\n' >&2
    exit 1
fi
grep -q 'already published' "$fixture/existing.out" || { cat "$fixture/existing.out" >&2; exit 1; }
[[ "$(sha256sum "$fixture/registry/index.json")" == "$before" ]] || { printf 'FAIL: index changed on duplicate\n' >&2; exit 1; }

for id in html emmet git-firefly; do
    (cd "$fixture" && PATH="$fixture/bin:$PATH" RELEASE_EXISTS=0 script/publish "$id" --dry-run > "$fixture/dry-run.out")
    url="https://github.com/tejasholla/symbiont-extensions/releases/download/$id-v0.1.0/$id.tar.gz"
    jq -e --arg id "$id" --arg url "$url" \
        'select(.id == $id and .version == "0.1.0" and .download_url == $url)' \
        "$fixture/dry-run.out" > /dev/null
    jq -e --arg id "$id" --arg url "$url" '
        (keys | sort) == (["id", "name", "version", "description", "authors", "repository", "schema_version", "wasm_api_version", "provides", "published_at", "download_url"] | sort)
        and .id == $id
        and (.name | type == "string" and length > 0)
        and .version == "0.1.0"
        and (.description | type == "string")
        and (.authors | type == "array" and length > 0 and all(.[]; type == "string"))
        and .repository == "https://github.com/tejasholla/symbiont-extensions"
        and .schema_version == 1
        and .wasm_api_version == (if $id == "git-firefly" then null else "0.1.0" end)
        and (.provides | type == "array" and length > 0 and all(.[]; IN("languages", "grammars", "language-servers")))
        and (.published_at | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
        and .download_url == $url
    ' "$fixture/dry-run.out" > /dev/null
    if [[ "$id" == html ]]; then
        cp "$fixture/dry-run.out" "$fixture/html-dry-run.out"
    fi
    [[ "$(sha256sum "$fixture/registry/index.json")" == "$before" ]] || { printf 'FAIL: dry run changed index\n' >&2; exit 1; }
done

(cd "$fixture" && PATH="$fixture/bin:$PATH" RELEASE_EXISTS=0 script/publish html > "$fixture/published.out" 2>&1)
[[ "$(sed -n '1p' "$CALLS")" == push ]] || { printf 'FAIL: release preceded push\n' >&2; exit 1; }
grep -q -- '--target test-head-sha' "$CALLS" || { printf 'FAIL: release target missing\n' >&2; exit 1; }
jq -e --slurpfile expected "$fixture/html-dry-run.out" \
    '(.extensions | type == "array" and length == 1) and (.extensions[0] | del(.published_at) == ($expected[0] | del(.published_at)))' \
    "$fixture/registry/index.json" > /dev/null
before_failed_push=$(sha256sum "$fixture/registry/index.json")
: > "$CALLS"
if (cd "$fixture" && PATH="$fixture/bin:$PATH" PUSH_FAIL=1 script/publish emmet > "$fixture/push-failed.out" 2>&1); then
    printf 'FAIL: failed index push was accepted\n' >&2
    exit 1
fi
grep -q 'Index push failed' "$fixture/push-failed.out" || { cat "$fixture/push-failed.out" >&2; exit 1; }
grep -q 'Push the local publish commit' "$fixture/push-failed.out" || { printf 'FAIL: recovery hint missing\n' >&2; exit 1; }
[[ "$(sed -n '1p' "$CALLS")" == push ]] || { printf 'FAIL: failed push did not occur\n' >&2; exit 1; }
[[ "$(wc -l < "$CALLS")" == 1 ]] || { printf 'FAIL: release created after failed push\n' >&2; exit 1; }
[[ "$(sha256sum "$fixture/registry/index.json")" != "$before_failed_push" ]] || { printf 'FAIL: failed push did not leave a recoverable local index commit\n' >&2; exit 1; }
printf 'PASS: dirty and unpushed trees refused; duplicate refused; three dry-run entries match registry fields; push precedes targeted release\n'
